/watcom/
*.LIB
*.lib
*.iso
*.ISO

# Allow the committed Watcom binaries (*.EXE is ignored above): 10.0 GA (dosga/, the default compiler) and the
# 10.0 LA wcc386 with the 10.0a DOS/4GW (dosla/, w10a/; kept as a fallback, WATCOM_VER=la)
!tools/watcom/
!tools/watcom/**/
!tools/watcom/dosla/WCC386.EXE
!tools/watcom/w10a/WATCOM/BIN/DOS4GW.EXE
!tools/watcom/w10a/WATCOM/BIN/W32RUN.EXE
!tools/watcom/dosga/WCC386.EXE
!tools/watcom/dosga/DOS4GW.EXE
!tools/watcom/dosga/W32RUN.EXE

