# PortMaster gptk: pad drives the PC glove pointer (desk). Plus has no analog;
# d-pad is the glove. H left stick is the same mouse. A left-click, B right-click.
# Select stays unbound so SDL Back opens the Overbar overlay (Online stays listed).
# Select+Start quits (PortMaster). In-play joystick is a later native HAL unit.
up = mouse_movement_up
down = mouse_movement_down
left = mouse_movement_left
right = mouse_movement_right
a = mouse_left
b = mouse_right
x = \"
y = \"
l1 = \"
r1 = \"
l2 = \"
r2 = \"
start = \"
select = \"
left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right
deadzone_triggers = 3000
mouse_scale = 6144
mouse_delay = 16
